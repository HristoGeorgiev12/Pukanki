<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Fallback / Hidden Sniffer WebView -->
    <WebView
        android:id="@+id/snifferWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- Native Media3 ExoPlayer View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_timeout="3500"
        app:use_controller="true" />

    <!-- Top TV Player HUD (Title + Source + Switch button) -->
    <LinearLayout
        android:id="@+id/playerTopHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="14dp"
        android:paddingRight="24dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hudMovieTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Филм"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hudSourceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нативен ExoPlayer • 🇧🇬 Streamtape • OK=Пауза | ◀▶=±15с | ▲=Следващ"
                android:textColor="#34D399"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/hudNextSourceBtn"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_btn_secondary"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="⏭ Следващ плеър"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/hudWebFallbackBtn"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_secondary"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="🌐 Уеб режим"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Center Toast / Seek Feedback Badge -->
    <TextView
        android:id="@+id/seekFeedbackText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC0B0F19"
        android:paddingLeft="24dp"
        android:paddingTop="14dp"
        android:paddingRight="24dp"
        android:paddingBottom="14dp"
        android:text="⏸ Пауза"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Loading Overlay while extracting stream -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60B0F19"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp" />

        <TextView
            android:id="@+id/loadingStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Извличане на видео поток..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loadingSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Подготовка на нативния плеър"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/loadingNextBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_secondary"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="⏭ Превключи към следващ плеър"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
